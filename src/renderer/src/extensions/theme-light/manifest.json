{
  "name": "theme-light",
  "version": "1.0.0",
  "displayName": "Light 主题",
  "author": "Obox",
  "description": "浅色主题",
  "main": "./index.ts",
  "contributes": {
    "themes": [
      {
        "id": "theme-light.light",
