{
  "name": "obox-todo-ext",
  "version": "1.0.0",
  "private": true,
  "description": "待办扩展（Obox 用户扩展，经 .oix 分发安装）。与 obox 宿主只有扩展 API 依赖关系。",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "pack": "node scripts/pack.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "release": "npm run typecheck && npm run build && npm run pack"
  },
  "dependencies": {
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "adm-zip": "^0.6.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
